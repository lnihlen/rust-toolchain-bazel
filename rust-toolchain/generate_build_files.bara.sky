def add_default_pkg_overrides(pkg_extra_kwargs):
    default_version_overrides = {
        # Upstream rustc pins libc in some places https://github.com/bytecodealliance/rustix/issues/1496
        # We don't appear affected, and need a newer version of libc anyways.
        "libc": "0.2",
    }

    default_ignore_dependencies = [
        # Needed for building rustc to run on windows, which we don't support now.
        "windows",
    ]

    version_overrides = default_version_overrides | pkg_extra_kwargs.get("version_overrides", {})
    ignore_dependencies = default_ignore_dependencies + pkg_extra_kwargs.get("ignore_dependencies", [])

    return pkg_extra_kwargs | {
        "version_overrides": version_overrides,
        "ignore_dependencies": ignore_dependencies,
    }

