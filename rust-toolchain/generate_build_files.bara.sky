def _generate_stdlib_tests_impl(ctx):
    std_tests_dir = "TODO/rust_toolchain/library/std/tests"

    standalone_tests_paths = ctx.run(glob([std_tests_dir + "/*.rs"]))
    suite_tests_paths = ctx.run(glob([std_tests_dir + "/*/lib.rs"]))

    test_names = []
    test_map = {}

    for p in standalone_tests_paths:
        path_str = p.path
        filename = path_str.split("/")[-1]
        test_name = filename.removesuffix(".rs")
        if test_name == "common":
            continue
        test_names.append(test_name)
        test_map[test_name] = {
            "name": test_name,
            "path": "std/tests/" + filename,
            "is_suite": False,
        }

    for p in suite_tests_paths:
        path_str = p.path
        parts = path_str.split("/")
        suite_name = parts[-2]
        test_names.append(suite_name)
        test_map[suite_name] = {
            "name": suite_name,
            "path": "std/tests/" + suite_name + "/lib.rs",
            "is_suite": True,
            "dir": "std/tests/" + suite_name,
        }

    sorted_names = sorted(test_names)

    bzl_lines = [
        "# Generated by Copybara. DO NOT EDIT.",
        '"""Generated Rust standard library tests."""',
        "",
        'load("TODO/bazel_rules/rules_rust/rust:defs.bzl", "rust_test")',
        "",
        "# buildifier: disable=unused-variable",
        "def define_generated_tests(name = None):",
        '    """Defines generated rust_test targets for the standard library.',
        "",
        "    Args:",
        "        name: Unused name parameter required for macro convention.",
        '    """',
    ]

    extra_flags = {
        "sync": ["-Zcrate-attr=feature(sync_poison_mod)"],
    }

    extra_args = {
        "sync": [
            # timeouts
            "--skip=condvar::nonpoison_timeout_nanoseconds",
            "--skip=condvar::nonpoison_wait_timeout_wait",
            "--skip=condvar::nonpoison_wait_timeout_wake",
            "--skip=condvar::poison_timeout_nanoseconds",
            "--skip=condvar::poison_wait_timeout_wait",
            "--skip=condvar::poison_wait_timeout_wake",
            "--skip=mutex::poison_wait_timeout_wait",
            "--skip=rwlock::nonpoison_test_downgrade_observe",
            "--skip=rwlock::poison_test_downgrade_observe",
            "--skip=rwlock::test_rwlock_max_readers",
            # failures
            "--skip=rwlock::nonpoison_test_downgrade_atomic",
            "--skip=rwlock::nonpoison_test_downgrade_basic",
            "--skip=rwlock::poison_test_downgrade_atomic",
            "--skip=rwlock::poison_test_downgrade_basic",
        ],
        "thread": ["--skip=sleep_very_long"],
    }

    extra_crate_names = {
        "type-name-unsized": "type_name_unsized",
    }

    for name in sorted_names:
        t = test_map[name]
        path = t["path"]
        is_suite = t["is_suite"]

        if is_suite:
            srcs_val = 'native.glob(["' + t["dir"] + '/**/*.rs"]) + ["std/tests/common/mod.rs"]'
        else:
            srcs_val = '["' + path + '", "std/tests/common/mod.rs"]'

        deps_val = [
            '"TODO/rust/rand/v0_9:rand"',
            '"TODO/rust/rand_xorshift/v0_4:rand_xorshift"',
        ]

        flags = []
        if name in extra_flags:
            flags = extra_flags[name]

        if flags:
            flags_val = "[" + ", ".join(['"' + f + '"' for f in flags]) + "]"
        else:
            flags_val = "[]"

        args_lines = []
        if name in extra_args:
            args_entries = extra_args[name]
            has_comments = any([a.startswith("#") for a in args_entries])
            if has_comments or len(args_entries) > 1:
                args_lines.append("        args = [")
                for a in args_entries:
                    if a.startswith("#"):
                        args_lines.append("            " + a)
                    else:
                        args_lines.append('            "' + a + '",')
                args_lines.append("        ],")
            else:
                args_lines.append('        args = ["' + args_entries[0] + '"],')

        crate_name = extra_crate_names.get(name, None)
        crate_name_line = ('        crate_name = "' + crate_name + '",\n') if crate_name else ""

        test_lines = [
            "    rust_test(",
            '        name = "std_' + name + '_test",',
            "        srcs = " + srcs_val + ",",
        ]
        if args_lines:
            test_lines.extend(args_lines)
        if crate_name_line:
            test_lines.append(crate_name_line.rstrip())
        test_lines.extend([
            '        crate_root = "' + path + '",',
            '        edition = "2024",',
            "        rustc_flags = " + flags_val + ",",
            "        deps = [" + ", ".join(deps_val) + "],",
            "    )",
            "",
        ])

        bzl_lines.extend(test_lines)

    library_path = "TODO/rust_toolchain/library"

    ctx.write_path(
        ctx.new_path(library_path + "/generated_tests.bzl"),
        "\n".join(bzl_lines) + "\n",
    )

    ctx.run(format.buildifier(paths = [
        library_path + "/generated_tests.bzl",
    ]))

def generate_stdlib_tests():
    return core.dynamic_transform(
        _generate_stdlib_tests_impl,
        params = {},
    )

def update_build_file(tool, pkg):
    path = tool_path[tool] + "/" + pkg
    return [
        core.dynamic_transform(
            lambda ctx: ctx.console.info("Updating BUILD file for {}".format(path)),
        ),
        update_crate_build_file(
            pkg,
            "TODO/rust_toolchain/" + path,
        ),
    ]

def generate_build_files_transformations(tools = tools, pkgs = all_pkgs):
    transformations = [
        tr
        for tool in tools
        for pkg in tool_pkgs[tool]
        if pkg in pkgs
        for tr in update_build_file(tool, pkg)
    ]
    transformations.append(generate_stdlib_tests())
    return transformations

files_glob = glob([
    "TODO/rust_toolchain/compiler/**",
    "TODO/rust_toolchain/src/build_helper/**",
    "TODO/rust_toolchain/src/shim_utils/**",
    "TODO/rust_toolchain/src/tools/rustfmt/**",
    "TODO/rust_toolchain/src/librustdoc/**",
    "TODO/rust_toolchain/src/rustdoc-json-types/**",
    "TODO/rust_toolchain/src/tools/rustdoc/**",
    "TODO/rust_toolchain/src/tools/clippy/**",
    "TODO/rust_toolchain/src/tools/compiletest/**",
    "TODO/rust_toolchain/src/tools/miropt-test-tools/**",
    "TODO/rust_toolchain/src/tools/rust-analyzer/**",
    "TODO/rust_toolchain/library/*.bzl",
    "TODO/rust_toolchain/library/std/tests/**",
])

def generate_build_files_workflow(
        name = "generate_build_files",
        tools = tools,
        pkgs = all_pkgs):
    return core.workflow(
        name = name,
        origin = piper.origin(),
        origin_files = files_glob,
        destination_files = files_glob,
        destination = piper.destination(),
        authoring = authoring.overwrite("Foo Bar <noreply@foobar.com>"),
        transformations = [
            # Needed for workflows with origin piper.
            leakr.disable_check("piper-to-piper"),
        ] + generate_build_files_transformations(tools, pkgs),
    )
